{
  "name": "cadence-reminder-app",
  "version": "1.0.0",
  "private": true,
  "description": "A personal periodic task reminder app with a TypeScript server and Neon PostgreSQL persistence.",
  "type": "module",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.client.json",
    "start": "node dist/server/server.js",
    "dev": "npm run build && npm start",
    "db:migrate": "npm run build:server && node dist/server/migrate.js",
    "db:import": "npm run build:server && node dist/server/import-json.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "pg": "^8.23.1"
  }
}
